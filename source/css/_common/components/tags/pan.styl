.md .pan {
  display: block;
  position: relative;
  min-width: 200px;
  max-width: 400px;
  margin-bottom: 5px;
  border-radius: 15px;
  text-decoration: none;
  border: 1px solid var(--color-grey);

  &:hover {
    cursor: pointer;
    text-decoration: none;
  }

  .pan-content-info {
    display: inline-block;
    width: 100%;
    box-sizing: border-box;
    padding: 14px 12px 14px 56px;
  }

  .pan-content-info {
    .pan-logo {
      display: inline-block;
      position: absolute;
      top: 12px;
      left: 12px;
      width: 36px;
      height: 36px;
      background-position: center center;
      background-repeat: no-repeat;
      background-size: cover;
    }

    .pan-title {
      display: flex;
      line-height: 1.2;
      font-size: 14px;
      font-family: PingFangSC-Regular;
      color: var(--text-color);
      text-align: left;
      margin: 0;

      .title {
        width: auto;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
    }

    .pan-desc {
      display: block;
      margin-top: 8px;
      font-size: 12px;
      line-height: 1;
      color: var(--text-color);
      text-align: left;

      .pan-size {
        margin-right: 20px;
      }
    }
  }

  .pan-content-code {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 9px 12px;
    border-top: 1px solid #eee;

    .pan-code {
      display: flex;
      justify-content: space-between;
      align-items: center;
      line-height: 1;

      .code-info {
        font-family: PingFangSC-Regular;
        font-size: 12px;
        color: var(--text-color);
        cursor: pointer;
        user-select: none;

        .code-toggle:not(:checked) ~ .code-text {
          filter: blur(4px);
        }

        .code-text {
          transition: filter 0.2s ease;
        }
      }

      .code-btn {
        display: inline-block;
        font-family: PingFangSC-Regular;
        font-size: 12px;
        color: var(--color-green);
        line-height: 30px;
        text-align: center;
        padding: 0 9px;
        border: 1px solid var(--color-green);
        border-radius: 14px;
        transition: all 0.2s ease;
        cursor: pointer;

        &:hover {
          color: #fff;
          background: var(--color-green);
        }
      }
    }

    .pan-no-code {
      flex-direction: row-reverse;
    }
  }
}

// 盘卡片多列自适应布局 — 宽屏三列并排，窄屏单列堆叠
.pan-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 5px;

  .pan {
    max-width: none;
    margin-bottom: 0;
  }
}

@media (max-width: 600px) {
  .pan-row {
    grid-template-columns: 1fr;
  }
}
