// ========================================
// Element UI - Button
// ========================================
.el-button
  display inline-block
  line-height 1
  white-space nowrap
  cursor pointer
  background #FFF
  border 1px solid #DCDFE6
  color #606266
  -webkit-appearance none
  text-align center
  box-sizing border-box
  outline 0
  margin 0
  transition .1s
  font-weight 500
  -moz-user-select none
  -webkit-user-select none
  -ms-user-select none
  user-select none
  padding 12px 20px
  font-size 14px
  border-radius 4px

  & + .el-button
    margin-left 10px

  &:focus,
  &:hover
    color #409EFF
    border-color #c6e2ff
    background-color #ecf5ff

  &:active
    color #3a8ee6
    border-color #3a8ee6
    outline 0

  &::-moz-focus-inner
    border 0

  [class*="el-icon-"] + span
    margin-left 5px

  // is-plain
  &.is-plain
    &:focus,
    &:hover
      background #FFF
      border-color #409EFF
      color #409EFF

    &:active
      background #FFF
      outline 0

  // is-active
  &.is-active
    color #3a8ee6
    border-color #3a8ee6

  // is-disabled
  &.is-disabled
    color #C0C4CC
    cursor not-allowed
    background-image none
    background-color #FFF
    border-color #EBEEF5

    &:focus,
    &:hover
      color #C0C4CC
      cursor not-allowed
      background-image none
      background-color #FFF
      border-color #EBEEF5

    &.el-button--text
      background-color transparent

    &.is-plain
      background-color #FFF
      border-color #EBEEF5
      color #C0C4CC

      &:focus,
      &:hover
        background-color #FFF
        border-color #EBEEF5
        color #C0C4CC

  // is-loading
  &.is-loading
    position relative
    pointer-events none

    &:before
      pointer-events none
      content ''
      position absolute
      left -1px
      top -1px
      right -1px
      bottom -1px
      border-radius inherit
      background-color rgba(255,255,255,.35)

  // is-round
  &.is-round
    border-radius 20px
    padding 12px 23px

  // is-circle
  &.is-circle
    border-radius 50%
    padding 12px

