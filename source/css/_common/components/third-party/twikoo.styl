  width 1.6rem

  .tk-avatar-img
    height 1.6rem

// Meta Input
.tk-meta-input
  display flex
  margin-bottom 0.5rem

  .el-input
    width auto
    width calc((100% - 1rem) / 3)
    flex 1

    & + .el-input
      margin-left 0.5rem

    .el-input-group__prepend
      padding 0 1rem

    input:invalid
      border 1px solid #f56c6c
      box-shadow none

  @media screen and (max-width: 767px)
    flex-direction column

    .el-input
      width auto

      & + .el-input
        margin-left 0
        margin-top 0.5rem

// Submit
.tk-submit
  display flex
  flex-direction column
  margin-top 1rem

.tk-row
  display flex
  flex-direction row
  flex 1
  justify-content space-between

  &.actions
    position relative
    margin-top 1rem
    margin-bottom 1rem
    margin-left 3.5rem
    align-items center
    justify-content flex-end

.tk-row-actions-start
  flex 1
  display flex
  align-items center

.tk-col
  flex 1
  display flex
  flex-direction column

.tk-submit-action-icon
  align-self center
  display inline-block
  width 1.25em
  line-height 0
  margin-right 10px
  cursor pointer
  flex-shrink 0

  svg:hover
    opacity 0.8

  &.__markdown
    color #909399

.tk-error-message
  word-break break-all
  color #ff0000
  font-size 0.75em
  flex-shrink 1

.tk-input-image
  display none

.tk-input
  flex 1

  .el-textarea__inner
    background right bottom/contain no-repeat

// Captcha containers
.tk-turnstile-container
  position absolute
  right 0
  bottom -75px
  z-index 1

.tk-turnstile
  display flex
  flex-direction column

.tk-geetest-container
  position absolute
  right 0
  bottom -75px
  z-index 1

.tk-cap-container
  position absolute
  right 0
  bottom -75px
  z-index 1

// Preview
.tk-preview-container
  margin-left 3rem
  margin-bottom 1rem
  padding 5px 15px
  border 1px solid rgba(128,128,128,0.31)
  border-radius 4px
  word-break break-word

  img
    display inline
    vertical-align bottom !important
    padding-left 4px
    padding-right 4px

.tk-fade-in
  animation tkFadeIn .3s

@keyframes tkFadeIn
  0%
    opacity 0
  to
    opacity 1

// Main
.tk-main
  flex 1
  width 0

.tk-nick-link
  color inherit
  text-decoration none

  &:hover
    color #409eff

.tk-replies .tk-nick-link
  font-size .9em

// Actions
.tk-actions
  display none
  margin-left 1em

  button
    appearance none
    background none
    border none
    padding 0
    margin 0
    text-decoration none
    display inline
    color #409eff
    cursor pointer

.tk-comment:hover .tk-actions
  display inline

// Extras
.tk-extras
  color #999999
  font-size 0.875em
  display flex
  flex-wrap wrap

.tk-extra
  margin-top 0.5rem
  margin-right 0.75rem
  display flex
  align-items center

.tk-icon.__comment
  height 1em
  width 1em
  line-height 1

.tk-extra-text
  line-height 1

// Tags
.tk-tag
  display inline-block
  padding 0 0.5em
  font-size 0.75em
  background-color #f2f6fc

// 原生 tk-tag-green 用 CSS 自定义属性驱动，支持 tagColor 配置
.tk-tag-green
  background-color unquote("color-mix(in srgb, var(--twikoo-master-color, #67c23a) 13%, transparent)")
  border 1px solid unquote("color-mix(in srgb, var(--twikoo-master-color, #67c23a) 50%, transparent)")
  border-radius 2px
  color var(--twikoo-master-color, #67c23a)

.tk-tag-yellow
  background-color rgba(230,162,60,0.13)
  border 1px solid rgba(230,162,60,0.50)
  border-radius 2px
  color #e6a23c

.tk-tag-blue
  background-color rgba(64,158,255,0.13)
  border 1px solid rgba(64,158,255,0.50)
  border-radius 2px
  color #409eff

.tk-tag-red
  background-color rgba(245,108,108,0.13)
  border 1px solid rgba(245,108,108,0.50)
  border-radius 2px
  color #f56c6c

// ========================================
// Commenter Tag Badges（tagMeta / tagMember）
// tk-tag-green 用于 DB master=true 用户 → Twikoo 原生渲染
// tk-tag-master 用于 tagMember.master 用户 → JS 注入
// 两者共用相同的 CSS 自定义属性（由 JS 从 tagColor 配置注入）
// ========================================
.tk-tag-master
  background-color unquote("color-mix(in srgb, var(--twikoo-master-color, #ec8c69) 13%, transparent)")
  border 1px solid unquote("color-mix(in srgb, var(--twikoo-master-color, #ec8c69) 50%, transparent)")
  border-radius 2px
  color var(--twikoo-master-color, #ec8c69)
  margin-left 0.25em

.tk-tag-visitor
  background-color unquote("color-mix(in srgb, var(--twikoo-visitor-color, #909399) 13%, transparent)")
  border 1px solid unquote("color-mix(in srgb, var(--twikoo-visitor-color, #909399) 50%, transparent)")
  border-radius 2px
  color var(--twikoo-visitor-color, #909399)
  margin-left 0.25em

.tk-tag-friend
  background-color unquote("color-mix(in srgb, var(--twikoo-friend-color, #3e999f) 13%, transparent)")
  border 1px solid unquote("color-mix(in srgb, var(--twikoo-friend-color, #3e999f) 50%, transparent)")
  border-radius 2px
  color var(--twikoo-friend-color, #3e999f)
  margin-left 0.25em

.tk-tag-investor
  background-color unquote("color-mix(in srgb, var(--twikoo-investor-color, #ed6ea0) 13%, transparent)")
  border 1px solid unquote("color-mix(in srgb, var(--twikoo-investor-color, #ed6ea0) 50%, transparent)")
  border-radius 2px
  color var(--twikoo-investor-color, #ed6ea0)
  margin-left 0.25em

// Comment
.tk-comment
  margin-top 1rem
  display flex
  flex-direction row
  word-break break-all

// Content
.tk-content
  margin-top 0.5rem
  overflow hidden
  max-height 500px
  position relative

  // 折叠时底部渐变遮罩（参考 valine 的做法）
  &:not(.tk-content-expand)::after
    display block
    content ""
    position absolute
    width 100%
    left 0
    bottom 0
    height 3.5em
    background linear-gradient(180deg, var(--grey-1-a0), var(--grey-1))
    z-index 1
    pointer-events none

  img
    display inline
    vertical-align bottom !important
    padding-left 4px
    padding-right 4px

.tk-content-expand
  max-height none

.tk-replies .tk-content
  font-size .9em

.tk-comment .vemoji
  max-height 2em
  vertical-align middle

// Replies
.tk-replies
  max-height 200px
  overflow hidden
  position relative

  // 折叠时底部渐变遮罩（参考 valine 的做法）
  &:not(.tk-replies-expand)::after
    display block
    content ""
    position absolute
    width 100%
    left 0
    bottom 0
    height 3em
    background linear-gradient(180deg, var(--grey-1-a0), var(--grey-1))
    z-index 1
    pointer-events none

.tk-replies-expand
  max-height none
  overflow unset

// Expand
.tk-expand
  font-size 0.75em
  width 100%
  cursor pointer
  padding 0.5em
  text-align center
  transition all 0.25s ease
  color var(--grey-5)
  background transparent
  border none
  outline none
  user-select none

  // 小箭头暗示可展开
  &::after
    content ""
    display inline-block
    width 0.4em
    height 0.4em
    margin-left 0.4em
    border-right 1.5px solid currentColor
    border-bottom 1.5px solid currentColor
    transform rotate(45deg) translateY(-0.15em)
    transition transform 0.25s ease
    vertical-align middle

  &:hover
    color var(--primary-color)
    letter-spacing 0.5px

    &::after
      transform rotate(45deg) translateY(0.05em)

  &:active
    color var(--color-aqua)
    transform scale(0.98)

// Lightbox
.tk-lightbox
  display block
  position fixed
  background-color rgba(0,0,0,0.3)
  top 0
  left 0
  right 0
  bottom 0
  z-index 999

.tk-lightbox-image
  min-width 100px
  min-height 30px
  width auto
  height auto
  max-width 95%
  max-height 95%
  position absolute
  top 50%
  left 50%
  transform translate(-50%, -50%)
  background linear-gradient(90deg, #eeeeee 50%, #e3e3e3 0)
  background-size 40px 100%

// Comments Title
.tk-comments-title
  font-size 1.25rem
  font-weight bold
  line-height 1
  margin-bottom 1rem
  display flex
  align-items center
  justify-content space-between
  gap 0.75rem

.tk-comments-count
  flex-shrink 0
  white-space nowrap

  &.__hidden
    visibility hidden

.tk-comments-actions
  display flex
  align-items center
  gap 0.5em
  white-space nowrap

// Comments Container
.tk-comments-container
  min-height 10rem
  display flex
  flex-direction column

.tk-comments-no
  flex 1
  text-align center
  display flex
  align-items center
  justify-content center

.tk-comments-error
  font-size 0.75em
  color #ff0000

// Sort
.tk-comments-sort
  display flex
  align-items center
  gap 0.75em
  margin-right 0.5em
  line-height 1

.tk-sort-item
  display inline-flex
  align-items center
  font-size 0.75rem
  line-height 1
  padding 0
  border 0
  background transparent
  cursor pointer
  color rgba(64,158,255,0.6)

  &.__active
    color #409eff

  &:focus
    outline none
    color #409eff

// Icon
.tk-icon.__comments
  display inline-flex
  align-items center
  justify-content center
  vertical-align middle
  height 0.75rem
  width 0.75rem
  line-height 0
  flex-shrink 0
  cursor pointer
  color #409eff

  svg
    display block
    width 100%
    height 100%

// Code Toolbar
.twikoo div.code-toolbar
  position relative
  border-radius .3em

  > .toolbar
    position absolute
    right 4px
    top 4px
    font-size .8125rem
    font-weight 500
    display flex

    > .toolbar-item
      margin-left .3em

      > a,
      > button,
      > span
        padding 2px 4px
        border-radius .3em

      > button
        border 1px solid rgba(128,128,128,0.31)

        &:hover
          cursor pointer

// Footer
.tk-footer
  width 100%
  text-align end
  font-size 0.75em
  color #999999
  margin-top 1em

// Pagination
.tk-pagination
  display flex
  width 100%
  align-items center
  justify-content space-between
  flex-wrap wrap

.tk-pagination-pagers
  display flex

.tk-pagination-options
  display flex
  align-items center

.tk-pagination-pager
  width 2em
  height 2em
  display flex
  align-items center
  justify-content center
  cursor pointer

  &.__current
    background-color #409eff
    pointer-events none

.tk-pagination .el-input
  width 50px

  .el-input__inner
    padding 0
    height 28px
    text-align center
    -moz-appearance textfield
    appearance textfield

    &::-webkit-inner-spin-button,
    &::-webkit-outer-spin-button
      -webkit-appearance none
      appearance none
      margin 0

// ========================================
// Admin Panel
// ========================================
.tk-admin-comment
  display flex
  flex-direction column
  align-items center

  a
    color currentColor
    text-decoration underline

  .tk-avatar
    margin-right 0.5em

  .tk-content
    max-height none

.tk-admin-warn
  margin-bottom 1em
  padding 1rem 1.5rem
  background-color #fff7d0
  border-left 0.5rem solid #e7c000
  color #6b5900
  align-self stretch

.tk-admin-security-alert
  position relative
  padding-right 2.5rem
  margin-bottom 0

  .tk-admin-close
    position absolute
    top 0
    right 0
    float none
    width 1rem
    height 1rem
    padding 0.5rem
    margin 0

.tk-admin-security-alert-message
  margin-bottom 0.5em

.tk-admin-security-alert-url
  word-break break-all
  background rgba(0,0,0,0.2)
  padding 0.5em
  border-radius 4px
  margin-bottom 0.5em

// Admin Filter
.tk-admin-comment-filter
  width 100%
  display flex
  align-items center
  justify-content flex-start

.tk-admin-comment-filter-keyword
  flex 1

.tk-admin-comment-filter-type
  height 32px
  margin 0 0.5em
  padding 0 0.5em
  color #ffffff
  background none
  border 1px solid rgba(144,147,153,0.31)
  border-radius 4px
  position relative
  -moz-appearance none
  -webkit-appearance none

  &:focus
    border-color #409eff

  option
    color initial

// Admin List
.tk-admin-comment-list
  margin-top 1em
  width 100%
  display flex
  flex-direction column
  justify-content stretch

.tk-admin-comment-item
  width 100%
  display flex
  flex-direction column
  justify-content stretch

.tk-admin-comment-meta
  display flex
  align-items center
  flex-wrap wrap
  margin-bottom 0.5em

.tk-admin-actions
  display flex
  margin-bottom 1em
  border-bottom 1px solid rgba(255,255,255,0.5)

// Admin Config
.tk-admin-config-groups
  overflow-y auto
  padding-right 0.5em
  position relative

  .tk-admin-config-group,
  .tk-admin-config-group-title
    background transparent

.tk-admin-config-group-title
  margin-top 1em
  font-size 1.25rem
  font-weight bold

.tk-admin-config-item
  display grid
  align-items center
  grid-template-columns 30% 70%
  margin-top 1em
  position relative

.tk-admin-config-title
  text-align right
  margin-right 1em
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.tk-admin-config-input
  position relative

.tk-admin-config-select
  -webkit-appearance none
  -moz-appearance none
  appearance none
  background none
  background-image url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 width=%2712%27 height=%2712%27 viewBox=%270 0 12 12%27%3E%3Cpath fill=%27%23ffffff%27 d=%27M6 8.825L1.175 4 2.238 2.938 6 6.7l3.763-3.762L10.825 4z%27/%3E%3C/svg%3E")
  background-repeat no-repeat
  background-position right 10px center
  border-radius 4px
  border 1px solid rgba(144,147,153,0.31)
  box-sizing border-box
  color #ffffff
  cursor pointer
  display inline-block
  font-size inherit
  height 32px
  line-height 32px
  outline none
  padding 0 30px 0 10px
  transition border-color .2s cubic-bezier(.645,.045,.355,1)
  width 100%

  &:focus
    border-color rgba(255,255,255,0.6)

  option
    color #fff
    background #333

.tk-admin-config-desc
  margin-top 0.5em
  font-size 0.75em
  overflow-wrap break-word

.tk-admin-config-actions
  display flex
  align-items center
  justify-content center
  margin-top 1em

.tk-admin-config-message
  margin-top 0.5em
  text-align center

.tk-admin-config-email-test-desc
  margin 1em 0

// Admin Import
.tk-admin-import
  display flex
  flex-direction column

.tk-admin-import-label
  margin-top 1em
  font-size 1.25rem
  font-weight bold

.tk-admin-import
  select,
  input,
  .el-button,
  .el-textarea
    margin-top 1em

// Admin Container
.tk-admin-container
  position absolute
  top 0
  left 0
  width 100%
  height 100%
  overflow hidden
  pointer-events none

.tk-admin
  position absolute
  top 0
  left 100%
  width 100%
  height 100%
  overflow-y auto
  pointer-events all
  color #ffffff
  background-color rgba(0,0,0,0.60)
  backdrop-filter blur(5px)
  transition all 0.5s ease
  visibility hidden

  &::-webkit-scrollbar
    width 5px
    background-color transparent

  &::-webkit-scrollbar-track
    background-color transparent

  &::-webkit-scrollbar-thumb
    background-color rgba(255,255,255,0.31)

  &.__show
    left 0
    visibility visible

.tk-admin-close
  appearance none
  background none
  border none
  margin 0
  text-decoration none
  cursor pointer
  position sticky
  float right
  display block
  top 0
  right 0
  width 1rem
  height 1rem
  padding 1rem
  box-sizing content-box
  color #ffffff

// Login / Regist
.tk-login,
.tk-regist
  display flex
  flex-direction column
  align-items center
  width 100%
  padding 0 2rem

.tk-login-title
  color #ffffff
  font-size 1.25rem
  text-align center
  margin-top 10rem

.tk-password,
.tk-login-msg
  color #ffffff
  width 80%
  text-align center
  margin-top 1rem

.tk-password .el-input__inner
  min-width 100px

.tk-login-msg a
  color #ffffff
  margin-left 1em
  text-decoration underline

.tk-regist-button
  margin-top 1rem

// Panel
.tk-panel
  color #ffffff
  padding 2rem

.tk-panel-title
  font-size 1.5rem
  display flex
  align-items flex-end
  justify-content space-between

.tk-panel-logout
  color #ffffff
  font-size 1rem
  text-decoration underline

.tk-panel .tk-tabs
  display flex
  margin-bottom 1em
  border-bottom 2px solid #c0c4cc

.tk-panel .tk-tab
  color #c0c4cc
  cursor pointer
  line-height 2em
  margin-right 2em
  margin-bottom -2px

  &.__active
    color #ffffff
    border-bottom 2px solid #ffffff

// ========================================
// Twikoo Root
// ========================================
.twikoo
  position relative
  margin: 1rem

  svg
    width 100%
    height 100%
    fill currentColor

// OwO Emotion / Emoji
.tk-owo-emotion,
.twikoo .OwO-item img
  width 3em
  height auto

// ========================================
// Element UI Overwrites for Twikoo
// ========================================

.twikoo
.el-input__inner,
.el-textarea__inner
  color currentColor
  background-color transparent
  border-color rgba(144,147,153,0.31)

  &:hover
    border-color rgba(144,147,153,0.50)

  &:focus
    border-color #409eff

.el-input-group__append,
.el-input-group__prepend
  color currentColor
  background-clip padding-box
  background-color rgba(144,147,153,0.13)
  border-color rgba(144,147,153,0.31)

.el-button:not(.el-button--primary):not(.el-button--text)
  color currentColor
  background-color rgba(144,147,153,0.063)
  border-color rgba(144,147,153,0.31)

  &:active,
  &:focus,
  &:hover
    color #409eff
    background-color rgba(64,158,255,0.063)
    border-color rgba(64,158,255,0.50)

.el-button--primary.is-disabled
  color rgba(255,255,255,0.63)
  background-color rgba(64,158,255,0.50)
  border-color transparent

  &:active,
  &:focus,
  &:hover
    color rgba(255,255,255,0.63)
    background-color rgba(64,158,255,0.50)
    border-color transparent

.el-loading-mask
  background-color transparent
  backdrop-filter opacity(20%)

.el-textarea .el-input__count
  color currentColor
  background transparent
