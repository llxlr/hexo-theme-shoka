// ── 单词拼读样式 ──
// 适配 Shoka 主题设计系统：全部颜色使用 CSS 自定义属性，自动继承明暗主题

.pronounce-word
  display inline-flex
  align-items center
  cursor pointer
  border-bottom 2px dotted var(--primary-color)
  color var(--text-color)
  transition all 0.2s ease
  user-select none

  &:hover
    color var(--color-blue)
    border-bottom-color var(--color-blue)

  &:active
    transform scale(0.96)

  &:focus-visible
    outline 2px solid var(--color-blue)
    outline-offset 2px
    border-radius 2px

  .pronounce-icon
    font-size 0.75em
    margin-left 2px
    opacity 0.5
    transition opacity 0.15s

  &:hover .pronounce-icon
    opacity 1

  // 适配 furigana <ruby> 音标
  ruby
    rp
      display none

  rt
    font-size 0.7em
    color var(--color-grey)
    text-align center
    line-height 1.2

// 播放中：红闪 + 缩放
.pronounce-active
  color var(--color-red)
  border-bottom-color var(--color-red)
  animation pronounce-pulse 0.8s ease-in-out

  .pronounce-icon
    opacity 1

// 拼读时当前字母高亮
.pronounce-curr
  color var(--color-red)
  font-weight 700
  font-size 1.15em
  text-decoration underline

@keyframes pronounce-pulse
  0%, 100%
    transform scale(1)
  50%
    transform scale(1.08)

// ── 不支持的浏览器 ──
.pronounce-unsupported
  cursor help
  border-bottom-style dashed
  border-bottom-color var(--color-grey)

  &:hover
    color var(--color-orange)
    border-bottom-color var(--color-orange)

  .pronounce-icon
    opacity 0.35

// 点击时不支持的抖动提示
.pronounce-shake
  animation pronounce-shake 0.4s ease-in-out

@keyframes pronounce-shake
  0%, 100%
    transform translateX(0)
  20%
    transform translateX(-4px)
  40%
    transform translateX(4px)
  60%
    transform translateX(-3px)
  80%
    transform translateX(3px)

// ── 兼容性 toast 提示 ──
.pronounce-toast
  position absolute
  max-width 360px
  padding 10px 14px
  background var(--grey-8)
  color var(--grey-0)
  font-size 13px
  line-height 1.5
  border-radius 6px
  box-shadow 0 4px 16px rgba(0, 0, 0, 0.18)
  z-index 9999
  pointer-events none
  animation pronounce-fade-in 0.25s ease-out

@keyframes pronounce-fade-in
  from
    opacity 0
    transform translateY(-4px)
  to
    opacity 1
    transform translateY(0)
