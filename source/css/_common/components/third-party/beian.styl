.beian
  display inline-block
  align-items center
  padding-left 10px
  margin-bottom .625rem

  a
    color currentColor
    text-decoration none

    &:hover
      border-bottom-color var(--color-blue)
      color var(--color-blue)

  .gongan
    height 14px
    margin-right 6px
    vertical-align middle
    transition transform 0.3s ease
