.operation {
  color: var(--grey-5);
  cursor: pointer;
  position: absolute;
  padding: .125rem .375rem;
  right: .125rem;
  top: .45rem;
  font-size: $font-size-smaller;

  span {
    the-transition();
    margin: 0 .3125rem;

    &:hover {
      color: var(--grey-7);
    }
  }

  > .dropdown-panel {
    display: none;
    position: absolute;
    top: 50%;
    right: 100%;
    margin: 0;
    transform: translateY(-50%);
    white-space: nowrap;
    gap: .625rem;
    padding: .125rem .3125rem;

    span {
      margin: 0;
    }
  }

  &:has(.more-btn.dropdown) {
    > .dropdown-panel {
      display: flex;
      align-items: center;
    }
  }

  .more-btn.dropdown {
    color: var(--color-green);

    &:hover {
      color: var(--color-green);
    }
  }

}
